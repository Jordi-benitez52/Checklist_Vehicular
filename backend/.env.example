# Django
DJANGO_SECRET_KEY=tu-clave-secreta-aqui
DEBUG=True

# Base de datos PostgreSQL
DB_NAME=checklist_vehicular_db
DB_USER=postgres
DB_PASSWORD=tu-password-de-db
DB_HOST=localhost
DB_PORT=5432

# Email (Gmail SMTP - usar App Password, NO tu password normal)
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-de-gmail
DEFAULT_FROM_EMAIL=LRA Checklist <tu-correo@gmail.com>

# Google OAuth (opcional, solo si usas login con Google)
GOOGLE_OAUTH_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=tu-secret