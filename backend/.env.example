# Django
DJANGO_SECRET_KEY=tu-clave-secreta-aqui-cambiar-en-produccion
DEBUG=True

# Base de datos PostgreSQL
DATABASE_URL=postgres://usuario:password@localhost:5432/checklist_vehicular_db

# Email (Gmail SMTP - usar App Password, NO tu password normal)
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-de-gmail
DEFAULT_FROM_EMAIL=LRA Checklist <tu-correo@gmail.com>

# Dominios permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8100,https://localhost:8100,http://localhost:5173,https://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8100,https://localhost:8100,http://localhost:5173,https://localhost:5173
FRONTEND_URL=http://localhost:5173

# Google OAuth (opcional, solo si usas login con Google)
GOOGLE_OAUTH_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=tu-secret